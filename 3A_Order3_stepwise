# Model info
model_name = "1-2-3-6-9-12 Order 3 stepwise aggregation model oligomerization model with equilibrium constants and assume kn is the same"
kinetic_constants = ['k1', 'k_1', 'k2', 'k_2', 'k3', 'k_3', 'k4', 'k_4', 'k5', 'k_5']
def ode_model(t, M, k):
    M1, M2, M3, M6, M9, M12 = M
    (k1, k_1, k2, k_2, k3, k_3, k4, k_4, k5, k_5) = k

  
    dM1 = -2*k1*M1**2 + 2*k_1*M2 - k2*M2*M1 + k_2*M3
    dM2 = k1*M1**2 - k_1*M2 - k2*M2*M1 + k_2*M3
    dM3 = k2*M2*M1 - k_2*M3 - 2*k3*M3**2 + 2*k_3*M6 - k4*M6*M3 + k_4*M9 - k5*M9*M3 + k_5*M12
    dM6 = k3*M3**2 - k_3*M6 - k4*M6*M3 + k_4*M9
    dM9 = k4*M6*M3 - k_4*M9 - k5*M9*M3 + k_5*M12
    dM12 = k5*M9*M3 - k_5*M12
    return [dM1,dM2,dM3,dM6,dM9,dM12]
